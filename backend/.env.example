# Copy this file to .env and fill in real values: cp .env.example .env
# Never commit the real .env file — it's already in .gitignore.

# Generate at https://djecrety.ir/
DJANGO_SECRET_KEY=

# True for local development, False in production
DJANGO_DEBUG=True

# Postgres connection string. Leave unset for local dev to fall back to
# SQLite automatically. In production (Render), set this to your Postgres
# instance's Internal Database URL, or every account/profile gets wiped
# whenever the service restarts (ephemeral disk).
DATABASE_URL=

# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# Redirect URI must exactly match one registered on the app (including
# trailing slash), e.g. http://127.0.0.1:8000/spotify/callback/ locally.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback/

# SoundCloud API client ID
SOUNDCLOUD_CLIENT_ID=

# RapidAPI key (used by lyric/genre lookups)
RAPIDAPI_KEY=

# HuggingFace inference API key, for the emotion-classification model
# (j-hartmann/emotion-english-distilroberta-base)
HF_API_KEY=
